# ── PDF app environment ───────────────────────────────────────────
# 이 파일을 `.env.local`로 복사한 뒤 값을 채우세요.

# Stirling-PDF 서버 주소 (선택 — 기본값: http://127.0.0.1:8080)
# PDF 변환/병합 등 고급 기능은 로컬 Stirling-PDF 컨테이너가 필요합니다:
#   docker run -d -p 8080:8080 stirlingtools/stirling-pdf:latest
# 미설치 시 해당 기능만 비활성화되고 기본 뷰어는 정상 동작합니다.
# STIRLING_PDF_URL=http://127.0.0.1:8080
