# ── Mail app environment ──────────────────────────────────────────
# 이 파일을 `.env.local`로 복사한 뒤 본인 키를 채우세요.
# `.env.local`은 gitignore 대상이며 절대 커밋/배포하면 안 됩니다.

# Resend 이메일 발송 API 키 (필수 — 메일 발송 기능)
# https://resend.com → API Keys 에서 발급 (도메인 인증 필요)
RESEND_API_KEY=

# Resend API 베이스 URL (선택 — 미설정 시 공식 엔드포인트)
# RESEND_BASE_URL=https://api.resend.com

# 수신 웹훅 서명 검증 시크릿 (수신 기능 사용 시 필수)
# Cloudflare 이메일 워커(workers/email-worker)와 동일한 값을 공유해야 합니다.
# 생성 방법: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INBOUND_WEBHOOK_SECRET=
