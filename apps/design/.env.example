# ── Design app environment ────────────────────────────────────────
# 이 파일을 `.env.local`로 복사한 뒤 본인 키를 채우세요.
# `.env.local`은 gitignore 대상이며 절대 커밋/배포하면 안 됩니다.

# OpenAI API 키 (필수 — 이미지 생성 기능)
# https://platform.openai.com/api-keys 에서 발급
OPENAI_API_KEY=

# 이미지 생성 엔드포인트 (선택 — 미설정 시 OpenAI 공식 API)
# OpenAI 호환 프록시/게이트웨이 사용 시에만 지정
# OPENAI_IMAGE_API_URL=https://api.openai.com/v1/images/generations

# 이미지 생성 모델 (선택 — 기본값: gpt-image-1)
# OPENAI_IMAGE_MODEL=gpt-image-1
