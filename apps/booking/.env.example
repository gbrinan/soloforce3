# ── Booking app environment ───────────────────────────────────────
# Copy this file to `.env.local` and fill in your OWN values.
# `.env.local` is gitignored and must NEVER be committed or shipped.

# Supabase (REQUIRED) — create a free project at https://supabase.com
# Dashboard → Settings → API → "Project URL" and "service_role" key.
# The service_role key bypasses RLS and is used server-side only.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend email (OPTIONAL) — https://resend.com
# Leave RESEND_API_KEY empty to disable sending (the app logs instead of emailing).
RESEND_API_KEY=
# Verified sender address on your Resend domain.
BOOKING_FROM_EMAIL=booking@yourdomain.com
# Host notification recipient (OPTIONAL) — gets a copy of each booking/cancel.
BOOKING_HOST_EMAIL=

# Base path (OPTIONAL)
# Leave EMPTY to serve the app at the site root (standalone deploy).
# Only set this when embedding inside the MyCrew host proxy.
NEXT_PUBLIC_BASE_PATH=
