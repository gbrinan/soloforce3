VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_MAPTILER_KEY=

# Same key used for map tiles rendering (Maps JavaScript API) and
# place text search (Places API New — places.googleapis.com/v1/places:searchText).
# GCP Console requirements for search to work:
#   1. Enable "Places API (New)" for this project
#   2. If the key has HTTP referrer restrictions, add the domain(s) this app is served from
# Without these, search silently falls back to free providers (Nominatim/Photon)
# with noticeably sparser results.
VITE_GOOGLE_MAPS_API_KEY=
