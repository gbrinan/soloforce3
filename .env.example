# My Crew 설정
# 이 파일을 .env로 복사하여 사용하세요: cp .env.example .env

# Claude Code CLI 경로 (필수)
# Mac/Linux에서 npm 글로벌 설치했으면 "claude"만 입력
# 직접 지정 예: ~/.local/bin/claude
CLAUDE_PATH=claude

# 작업 디렉토리 루트 (선택 — 비워두면 자동 감지)
# 에이전트가 생성하는 프로젝트가 저장되는 상위 디렉토리
WORKSPACE_ROOT=~/Documents/projects

# 프로젝트 폴더명 (선택 — 기본값: agentTeam)
# WORKSPACE_ROOT 아래에 생성되는 프로젝트 저장 폴더
# ⚠️ 한번 설정 후 변경하지 마세요. 기존 프로젝트 참조가 깨집니다.
PROJECTS_FOLDER=mycrew-works

# 외부 접속 — 아래 둘 중 택1 (둘 다 비워두면 로컬 전용)

# (A) ngrok 사용 시 (간편, 무료 플랜은 월간 요청 제한 있음)
# ngrok 대시보드(https://dashboard.ngrok.com/domains)에서 무료 도메인 발급 가능
# NGROK_URL=your-name.ngrok-free.app

# (B) SSH 터널 사용 시 (EC2 + 자체 도메인, 요청 제한 없음)
# EC2에 nginx 리버스 프록시 + SSL 설정 필요
# TUNNEL_HOST=your-ec2-ip
# TUNNEL_KEY=~/.ssh/your-key.pem
# TUNNEL_REMOTE_PORT=8080
# TUNNEL_URL=https://your-subdomain.example.com

# 승인 API 보안 토큰 (필수 — fail-secure)
# ⚠️ 미설정 시 /api/approvals/:id/resolve 가 모든 요청을 거부합니다(승인 동작 불가).
# 운영 전 반드시 설정하세요. 토큰 비교는 timing-safe.
# 생성 방법: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# APPROVAL_RESOLVE_TOKEN=your-random-token-here

# SSO 서명 비밀키 (선택 — 미설정 시 .sso-secret 파일에 자동 생성)
# 호스트→iframe 앱 자동 로그인용 HMAC-SHA256 서명 키.
# .sso-secret(0600) 파일을 디스크에 영속화하므로 평소엔 둘 다 미설정 가능.
# 멀티 인스턴스/도커 배포 시 env로 명시 권장(인스턴스 간 토큰 호환).
# 생성 방법: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SSO_SECRET=your-random-secret-here

# 포트 변경 (선택 — 기본값: 3456)
# PORT=3456

# Google OAuth 2.0 — 자비스에 Gmail/Calendar/Drive MCP 연동 시 필수
# 발급 절차: history/outputs/dev-pm/google-mcp-연동-안내서_dev-pm_2026-05-15.md 참조
# 미설정 시 google MCP 서버는 시작 실패 (다른 기능은 정상)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Google SSO 로그인 — 웹 접근을 허용 계정으로 제한 (외부 노출 시 권장)
# ⚠️ 위 GOOGLE_OAUTH_*(Gmail/Calendar MCP용)와 다른 별개 변수입니다.
# 아래 CLIENT_ID/SECRET 둘 다 설정해야 SSO 활성화. 미설정 시 로그인 없이 전체 접근(로컬 개발용).
# 발급: Google Cloud Console → API 및 서비스 → 사용자 인증 정보 → OAuth 2.0 클라이언트 ID(웹 애플리케이션)
#   - 승인된 리디렉션 URI: 아래 GOOGLE_CALLBACK_URL과 정확히 일치해야 함
#   - 동의 화면 scope: openid, email, profile
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=https://your-domain.example.com/auth/google/callback
# 접근 허용 계정(쉼표 구분). 미설정 시: (1) MYCREW_REQUIRE_SSO 패키지 배포본은 최초 로그인 계정을
# 소유자로 자동 등록(history/auth-owner.json), (2) 그 외에는 모든 로그인 거부.
# ALLOWED_EMAILS=you@example.com

# 소유자 이메일 — SSO를 켜지 않고 로컬 단일 사용자로 쓸 때 필요하다.
# SSO가 꺼져 있으면 세션이 없어 /api/sso/issue-token이 401을 뱉고, iframe 서브앱(일기·가계부·
# 메모 등)이 전부 자기 로그인 화면으로 떨어진다. 이 값이 있으면 그 계정으로 토큰을 발급해
# 서브앱 자동 로그인이 유지된다. SSO를 켜면 이 폴백은 발동하지 않는다.
# 아난다라 동기화(anandara-sync.ts)도 이 값을 쓴다 — 그쪽은 미설정 시 하드코딩 기본값으로 돈다.
# MYCREW_OWNER_EMAIL=you@example.com

# ── 패키지 배포본(맥/윈도우 설치본) 설정 ─────────────────────────────────
# MYCREW_REQUIRE_SSO=1  → Google OAuth 자격증명 없이도 SSO 게이트 활성.
#   로컬 브라우저가 마이크루를 열면 /onboarding으로 유도되어 스토어 Google SSO로 로그인,
#   최초 로그인 계정이 소유자로 등록되고 설정 화면으로 진입한다. 스킬/앱/데이터 동기화의 신원 기준.
# MYCREW_REQUIRE_SSO=1
# MYCREW_STORE_MANAGED=1  → 앱 런처가 "스토어에서 설치한 앱"만 노출(신품은 0개, 기본 플러그 메뉴만).
#   토글 플러그인/앱은 마이크루 스토어에서 설치해야 나타난다.
# MYCREW_STORE_MANAGED=1
# MYCREW_STORE_URL=https://store.dooitspace.com  # 온보딩 로그인이 향할 스토어 주소

# 외부 공개 URL (선택) — GOOGLE_CALLBACK_URL 미설정 + 요청에 Host 헤더가 없을 때 콜백 URL 베이스로 사용.
# 일반 웹 접속(Host 헤더 있음)에서는 자동 감지되므로 보통 비워둬도 됩니다.
# PUBLIC_BASE_URL=https://your-domain.example.com

# Google Drive 읽기 전용 connector — 위 Google SSO와 별도 OAuth client를 권장합니다.
# 승인된 리디렉션 URI는 아래 값과 정확히 같아야 하며 경로는 변경할 수 없습니다.
# GOOGLE_DRIVE_CONNECTOR_CLIENT_ID=
# GOOGLE_DRIVE_CONNECTOR_CLIENT_SECRET=
# GOOGLE_DRIVE_CONNECTOR_CALLBACK_URL=http://localhost:3456/api/connections/google-drive/oauth/callback
# PROJECTS_DIR 아래 이미 존재하는 프로젝트를 최대 2단 상대 경로로 선택합니다.
# GOOGLE_DRIVE_CONNECTOR_PROJECT_ID=education/client-project
# refresh token 암호화용 32-byte key(base64). 생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 이 값을 잃거나 교체하면 기존 연결 token을 복호화할 수 없으므로 비밀 저장소에 백업하고 Git에는 커밋하지 마세요.
# SOLOFORCE_CONNECTION_ENCRYPTION_KEY=

# 자료 수집: Notion 내부 연결의 읽기 토큰. 읽을 페이지에 해당 연결을 추가해야 합니다.
# NOTION_ACCESS_TOKEN=
# 선택적 로컬 벡터 검색. 모델은 같은 실행 환경에서 별도로 준비합니다.
# CORPUS_EMBED_MODEL=
# CORPUS_EMBED_URL=http://127.0.0.1:11434/api/embed
# IngesTiger Wiki 후보: Python 3 실행 파일 경로(인자 제외). 비워두면 Windows python, Mac/Linux python3.
# INGESTIGER_PYTHON=
# Wiki analysis uses the current Claude login. Default: MYCREW_AI_GW_DEFAULT_MODEL or claude-haiku-4-5.
# INGESTIGER_MODEL=claude-haiku-4-5
# 설정 절차와 처리 제한: config/corpus/README.md

# 여행(TREK) 자동 로그인 브리지 (선택)
# scripts/trek-proxy.mjs가 mycrew_sid 세션을 TREK 비밀번호 계정으로 자동 변환할 때 쓰는 HMAC 키.
# 미설정 시 프록시가 history/.trek-bridge-secret 을 자동 생성(0600). 보통 비워둬도 무방.
# 명시 시 .env가 우선. 키 회전 시 모든 사용자 재가입 필요.
# TREK_BRIDGE_SECRET=

# ── MyMaps (지도 앱) ─────────────────────────────────────────────────────────
# MapTiler 타일 서버 API 키 — https://cloud.maptiler.com → API Keys
# 미설정 시 앱이 OSM 래스터 타일(무인증)로 대체, 3D·위성 레이어 비활성.
# MAPTILER_API_KEY=

# ── MyCrew Store (v1.2 Google SSO 브릿지) ────────────────────────────────────
# mycrew-store(별도 Vercel 배포, apps/mycrew-store-scaffold)가 사용하는 Supabase 프로젝트와
# 동일한 URL/anon key. /api/store/session-import가 이 값으로 store 발급 access_token을
# Supabase Auth API(GET /auth/v1/user)에 검증 요청한다. anon key는 공개 가능한 값.
# 미설정 시 session-import는 503(store_supabase_not_configured) 반환.
# STORE_SUPABASE_URL=https://yyknaylktzanlcnwuecb.supabase.co
# STORE_SUPABASE_ANON_KEY=

# Supabase service_role 키 (v1.3 install/uninstall/check-updates 전용, 비공개 — 절대 유출 금지)
# manifests/installations 테이블에 RLS 우회 서버측 쓰기가 필요해 anon key와 별도로 사용.
# Supabase 대시보드 → Project Settings → API → service_role secret
# 미설정 시 install/uninstall/check-updates는 503(store_supabase_not_configured) 반환.
# STORE_SUPABASE_SERVICE_ROLE_KEY=

# 로컬 개발 전용 익명 폴백 (v1.7 감사 B-4 P0 수정 — 기본값 없음 = SSO 세션 없으면 401)
# store SSO 세션이 없는 요청도 설치/백업 API를 쓸 수 있게 공유 플레이스홀더 UUID로
# 폴백을 허용한다. 여러 사용자가 접근하는 배포 환경에서는 절대 설정하지 말 것 —
# 서로 다른 사용자의 백업/설치 데이터가 같은 UUID로 뒤섞인다.
# STORE_ALLOW_ANON=1

# mycrew-store 배포 오리진(쉼표 구분) — /api/store/* CORS 허용 목록.
# 미설정 시 기본값(http://localhost:3000,https://store.dooitspace.com,https://mycrew-store.vercel.app) 사용.
# STORE_ORIGIN=http://localhost:3000,https://store.dooitspace.com,https://mycrew-store.vercel.app

# 앱 런처 모달 "스토어 열기" 버튼이 여는 mycrew-store URL (클라이언트 빌드 시 번들에 포함됨)
# 미설정 시 기본값(https://mycrew-store.vercel.app) 사용. 배포 후 실 URL로 교체하세요.
# VITE_MYCREW_STORE_URL=https://mycrew-store.vercel.app

# ── 자비스뷰(음성 모드) ─────────────────────────────
# STT: Groq 우선, Gemini 폴백. 하나만 있어도 동작(둘 다 없으면 stt:false)
GROQ_API_KEY=
GEMINI_API_KEY=
# TTS 사이드카 (soloforce-voice 리포의 scripts/start-tts.sh 로 기동)
SUPERTONIC_URL=http://127.0.0.1:7788

# ── 도메인 노출 게이트 (P4) ─────────────────────────
# TUNNEL_URL/NGROK_URL/SOLOFORCE_DOMAIN 중 하나라도 설정되면 Google SSO(위 CLIENT_ID/SECRET)가 필수입니다.
# SSO 없이 의도적으로 공개하려면 아래를 명시해야 기동됩니다 (권장하지 않음).
# SOLOFORCE_ALLOW_PUBLIC_NOAUTH=1
# 배포 도메인 (예: myname.soloforce.app 또는 임의 도메인) — 설정 시 위 게이트 적용.
# SOLOFORCE_DOMAIN=

# Meeting Memory sidecar (Groq/Gemini transcription -> Gemini summary)
# Leave URL empty to keep the existing legacy meeting processor.
MEETING_MEMORY_URL=
MEETING_MEMORY_TOKEN=
MEETING_MEMORY_TRANSCRIBER=groq
