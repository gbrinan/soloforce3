      "writeSensitivePaths": [
        "/history/agents.json",
        "/history/genie-config.json",
        "/history/agents/**/wiki/role-directive.md"
      ],
      "maxCacheTokens": 5000000,
      "bashSensitivePatterns": [
        "rm\\s+-rf",
        "rm\\s+-r\\s+/",
        "\\bsudo\\b",
        "\\bchmod\\b",
        "\\bchown\\b",
        "curl.*\\|.*sh",
        "wget.*\\|.*sh",
        "\\bkill\\b",
        "\\bkillall\\b",
        "\\bpkill\\b",
        "\\beval\\b",
        "\\bexec\\b",
        "/\\.ssh/",
        "/\\.aws/",
        "/\\.gnupg/",
        "/\\.env\\b",
        "id_rsa|id_ed25519|id_ecdsa",
        "\\.pem\\b|\\.key\\b|\\.crt\\b|\\.p12\\b|\\.pfx\\b"
      ],
      "model": "claude-opus-5",
      "mcpServers": [
        "playwright",
        "excel"
      ],
      "interactive": true,
      "allowedEnvKeys": []
