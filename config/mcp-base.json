{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--headless"
      ]
    },
    "excel": {
      "command": "npx",
      "args": [
        "-y",
        "@negokaz/excel-mcp-server"
      ]
    },
    "lighthouse": {
      "command": "npx",
      "args": [
        "-y",
        "@danielsogl/lighthouse-mcp@latest"
      ]
    },
    "kordoc": {
      "command": "npx",
      "args": [
        "-y",
        "kordoc",
        "mcp"
      ]
    },
    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-supabase@latest",
        "--project-ref=jditahiwwhrugzyamecl"
      ],
      "env": {
        "SUPABASE_ACCESS_TOKEN": ""
      }
    }
  }
}
